# Multi-stage: build the dashboard SPA with Vite, then serve it with Caddy alongside TLS + API proxy.
FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
# Public API base URL baked into the SPA at build time (passed via compose build args).
ARG VITE_API_URL=http://127.0.0.1:4141
ENV VITE_API_URL=$VITE_API_URL
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json vitest.config.ts ./
COPY packages ./packages
COPY apps/dashboard ./apps/dashboard
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @agentshield/dashboard build

FROM caddy:2-alpine
COPY --from=build /app/apps/dashboard/dist /srv/dashboard
EXPOSE 80 443
