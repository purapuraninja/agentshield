FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @agentshield/api build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production AGENTSHIELD_HOST=0.0.0.0 AGENTSHIELD_PORT=4141 AGENTSHIELD_DATA_DIR=/data
COPY --from=build /app/apps/api/dist/server.cjs ./server.cjs
USER node
EXPOSE 4141
CMD ["node", "server.cjs"]
