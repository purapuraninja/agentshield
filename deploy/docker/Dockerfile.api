FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json vitest.config.ts ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/dashboard ./apps/dashboard
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @agentshield/api build
RUN pnpm --filter @agentshield/dashboard build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production AGENTSHIELD_HOST=0.0.0.0 AGENTSHIELD_PORT=4141 AGENTSHIELD_DATA_DIR=/data
COPY --from=build /app/apps/api/dist/server.cjs ./server.cjs
# Ensure the data directory is writable by the non-root `node` user. Fresh named volumes inherit
# this ownership, so the API can persist scans, audits, and remediation state without EACCES.
RUN mkdir -p /data && chown -R node:node /data
USER node
EXPOSE 4141
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4141/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.cjs"]
