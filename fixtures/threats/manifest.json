      "target": "T-02-misleading-mcp/mcp.json",
      "expect": ["AS-SC-024"]
    },
    {
      "id": "T-03",
      "title": "Shell script executes downloaded code",
      "kind": "scanner",
      "target": "T-03-download-execute/install.sh",
      "expect": ["AS-SC-002"]
    },
    {
      "id": "T-04",
      "title": "Untrusted document stores persistent instructions in memory (Indonesian)",
      "kind": "memory",
      "target": "T-04-poisoned-memory/memories.jsonl",
      "expect": ["AS-ME-010"]
    },
    {
      "id": "T-04s",
      "title": "Untrusted document carries persistent instructions (Indonesian, scanner)",
      "kind": "scanner",
      "target": "T-04-poisoned-memory/SKILL.md",
      "expect": ["AS-SC-017"]
    },
    {
      "id": "T-05",
      "title": "Old memory overrides current policy",
